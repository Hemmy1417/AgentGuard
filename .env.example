# AgentGuard reads no signing key from the environment: keys live in
# .data/ (gitignored), created by scripts/deploy_studionet.py (deployer) and
# scripts/generate_fixtures.py (demo wallets). Both optional settings below
# are read only when set; leave them empty in this file.

# 1 = let tests/integration send a write to the canonical deployment.
AGENTGUARD_LIVE_WRITES=
# GenVM runner bundle release for scripts/fetch_genvm_bundle.py.
GENVM_VERSION=
